# =============================================================================
# Manufacturing ERP - Environment variables (template)
# Copy this file to `.env` and adjust the values for your environment.
# =============================================================================

# --- Django core --------------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_LOG_LEVEL=INFO

# --- Database (PostgreSQL) ----------------------------------------------------
POSTGRES_DB=manufacturing_erp
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgres://erp_user:erp_password@127.0.0.1:5432/manufacturing_erp
DB_CONN_MAX_AGE=60

# --- Redis --------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_KEY_PREFIX=erp
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# --- Celery -------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- JWT ----------------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# --- Email --------------------------------------------------------------------
# Options: console (dev), smtp (prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Manufacturing ERP <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- CORS ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Localization -------------------------------------------------------------
TIME_ZONE=Asia/Karachi
LANGUAGE_CODE=en-us

# --- Observability (production) -----------------------------------------------
SENTRY_DSN=
